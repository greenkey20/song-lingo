# 이 파일을 .env 로 복사해서 값을 채웁니다 (.env 는 git에 올라가지 않습니다)
OPENAI_API_KEY=
# (선택, 웹 앱) 보컬 분리를 돌릴 파이썬. 앱 전용 환경에 torch·demucs가 없을 때 노트북 환경(voice-ai)의 파이썬을 지정합니다.
# 비워 두면 앱을 실행한 파이썬으로 돌립니다(그 환경에 demucs가 있어야 함, 배포 서버는 보통 비워 둠).
SONGLINGO_SEPARATE_PYTHON=
# (선택, 웹 앱) Azure Speech 발음 평가(이슈 #48). Azure 포털 > Speech 리소스 > 키 및 엔드포인트의 KEY 1과 지역(예: koreacentral). 버튼을 누를 때만 녹음이 Azure로 전송됩니다.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# (선택, 웹 앱 배포) 접근 제한 비밀번호(이슈 #52). 값이 있으면 앱이 비밀번호를 묻고, 비워 두면(개발) 바로 열립니다. 길고 추측하기 어려운 값을 쓰세요.
SONGLINGO_PASSWORD=
# (웹 앱, 사용자별 저장 — 이슈 #52) PostgreSQL 접속. 변수 이름은 inner-orbit과 같다. 서버는 DB_PORT=5433(전용 컨테이너), 내 컴퓨터 개발용은 55432.
# 비어 있으면(DB_NAME·DB_USER 없음) 저장 기능이 꺼지고 게스트 모드로만 동작한다. 비밀번호에는 $ # ' " 공백을 쓰지 않는다(docker compose가 .env를 읽을 때 해석이 달라짐).
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=songlingo_db
DB_USER=songlingo_app
DB_PASSWORD=
# (개발용, 선택) 서버 DB를 내 컴퓨터에서 시험할 때 진짜 데이터가 있는 public 대신 쓸 임시 스키마 이름(없으면 만들어 줌). 운영 서버에서는 비워 둔다.
DB_SCHEMA=
